// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  LAWYER
  CLIENT
  ACCOUNTANT
}

enum CaseStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CLOSED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum InquiryStatus {
  NEW
  CONTACTED
  CONVERTED
  CLOSED
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String
  name          String
  role          Role      @default(CLIENT)
  phone         String?
  secondaryPhone String?
  city          String?
  dateOfBirth   DateTime?
  nationalId    String?
  address       String?
  otherInfo     String?
  profileImage  String?
  litigationTeam String?
  department    String    @default("LITIGATION") // "LITIGATION" or "GENERAL"
  status        String    @default("ACTIVE") // "ACTIVE" or "DEACTIVATED"
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relationships
  casesAsClient    Case[]     @relation("ClientCases")
  casesAsLawyer    Case[]     @relation("LawyerCases")
  managedCases     Case[]     @relation("AdminCases")
  messagesSent     Message[]
  documentsUploaded Document[]
  payments         Payment[]
  verifiedPayments Payment[] @relation("PaymentVerifier")
  verifiedSubmissions PaymentSubmission[] @relation("SubmissionVerifier")
}

model Case {
  id          String     @id @default(uuid())
  title       String
  description String
  status      CaseStatus @default(OPEN)
  
  // Roles
  clientId    String
  client      User       @relation("ClientCases", fields: [clientId], references: [id])
  
  lawyerId    String?
  lawyer      User?      @relation("LawyerCases", fields: [lawyerId], references: [id])
  
  adminId     String?
  admin       User?      @relation("AdminCases", fields: [adminId], references: [id])

  litigationTeam String? // Assigned Litigation Team (e.g. TEAM ANCHOR, TITAN LITIGATION)
  category       String     @default("LITIGATION") // "LITIGATION" or "GENERAL"
  subCategory    String?    // e.g. "Property Law", "Monthly Retainer", "Tax Advisory", "Civil Dispute"
  suitNumber     String?
  court          String?
  stage          String?
  pendingTask    String?

  // Content
  documents   Document[]
  messages    Message[]
  courtDates  CourtDate[]
  payments    Payment[]
  timeline    CaseTimeline[]

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model CaseTimeline {
  id          String   @id @default(uuid())
  title       String
  description String?
  status      String?  // e.g. "OPEN", "IN_PROGRESS", "HEARING", "RESOLVED"
  date        DateTime @default(now())

  caseId      String
  case        Case     @relation(fields: [caseId], references: [id])

  createdById String?
  createdByName String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Document {
  id           String   @id @default(uuid())
  name         String
  url          String
  type         String   // PDF, DOCX, IMG, etc.
  
  caseId       String
  case         Case     @relation(fields: [caseId], references: [id])
  
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  
  createdAt    DateTime @default(now())
}

model Message {
  id        String   @id @default(uuid())
  content   String?
  fileUrl   String?
  
  caseId    String?
  case      Case?    @relation(fields: [caseId], references: [id])

  teamName  String?
  
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id])
  
  createdAt DateTime @default(now())
}

model Payment {
  id              String        @id @default(uuid())
  amount          Float
  currency        String        @default("NGN")
  status          PaymentStatus @default(PENDING)
  txRef           String        @unique // Internal reference
  flutterwaveRef  String?       @unique // Flutterwave reference
  description     String?
  dueDate         DateTime?

  // Bank account to pay into (for manual transfers)
  accountId       String?
  account         PaymentAccount? @relation(fields: [accountId], references: [id])

  // Proof of payment (manual bank transfer)
  proofUrl          String?
  proofType         String?
  proofSubmittedAt  DateTime?
  verifiedAt        DateTime?
  verifiedById      String?
  verificationNote  String?
  
  clientId        String
  client          User          @relation(fields: [clientId], references: [id])
  
  caseId          String
  case            Case          @relation(fields: [caseId], references: [id])

  verifiedBy      User?         @relation("PaymentVerifier", fields: [verifiedById], references: [id])
  submissions     PaymentSubmission[]
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model PaymentSubmission {
  id               String        @id @default(uuid())
  paymentId        String
  payment          Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  amount           Float
  accountId        String?
  account          PaymentAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  proofUrl         String?
  proofType        String?
  status           PaymentStatus @default(PENDING)
  submittedAt      DateTime      @default(now())
  proofExpiresAt   DateTime
  verifiedAt       DateTime?
  verifiedById     String?
  verifiedBy       User?         @relation("SubmissionVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  verificationNote String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([paymentId, status])
  @@index([proofExpiresAt])
}

model PaymentAccount {
  id           String   @id @default(uuid())
  label        String?
  bankName     String
  accountName  String
  accountNumber String
  currency     String   @default("NGN")
  isActive     Boolean  @default(true)

  payments     Payment[]
  submissions  PaymentSubmission[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model CourtDate {
  id          String   @id @default(uuid())
  date        DateTime
  location    String
  description String?
  
  caseId      String
  case        Case     @relation(fields: [caseId], references: [id])
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Inquiry {
  id            String        @id @default(uuid())
  name          String
  email         String
  phone         String?
  serviceNeeded String?
  message       String
  status        InquiryStatus @default(NEW)
  notes         String?

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Property {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  description String
  price       Float
  location    String
  category    String
  offerTypes  String[] @default(["SALE"])
  bedrooms    Int      @default(0)
  bathrooms   Int      @default(0)
  sizeSqm     Float?
  images      String[]
  features    String[]
  status      String   @default("AVAILABLE")
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
